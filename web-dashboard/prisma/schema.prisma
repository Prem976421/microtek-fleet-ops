// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      String   @default("TECHNICIAN") // ADMIN or TECHNICIAN
  createdAt DateTime @default(now())
}

model Inverter {
  id                  String           @id // e.g., INV_ESP32_001
  location            String
  locality            String           @default("Unknown")
  firmwareVersion     String           @default("v1.0.0")
  signalStrength      Int              @default(-70)
  gridVoltageBaseline Float            @default(230.0)
  healthState         Int              @default(0) // 0: Healthy, 1: Warning, 2: Critical, 3: Imminent Failure
  lastSeen            DateTime         @default(now())
  telemetry           TelemetryLog[]
  tickets             DispatchTicket[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model TelemetryLog {
  id                   Int      @id @default(autoincrement())
  inverterId           String
  inverter             Inverter @relation(fields: [inverterId], references: [id])
  
  // Environmental & Site
  ambientTemp          Float    @default(0.0)
  relativeHumidity     Float    @default(0.0)
  dustIndex            Float    @default(0.0)
  solarIrradiance      Float    @default(0.0)
  
  // Electrical & Power Quality
  dcBusRippleVoltage   Float    @default(0.0)
  dcBusRippleCurrent   Float    @default(0.0)
  activePower          Float    @default(0.0)
  reactivePower        Float    @default(0.0)
  acFrequencyDrift     Float    @default(0.0)
  insulationResistance Float    @default(0.0)
  thd                  Float    @default(0.0)
  mainsSurges          Int      @default(0)
  
  // Subsystem & Component
  junctionTemp         Float    @default(0.0)
  heatsinkTemp         Float    @default(0.0)
  heatsinkDelta        Float    @default(0.0)
  mosfetOnResistance   Float    @default(0.0)
  igbtVgeth            Float    @default(0.0)
  commandedFanRpm      Int      @default(0)
  actualFanRpm         Int      @default(0)
  smpsOutputVoltage    Float    @default(0.0)
  capacitorEsr         Float    @default(0.0)
  
  // Predictive Metrics
  conversionEfficiency Float    @default(0.0)
  cumulativeThermalStress Float @default(0.0)
  rulVelocity          Float    @default(0.0)
  
  timestamp            DateTime @default(now())
}

model DispatchTicket {
  id          String   @id @default(uuid()) // e.g. TKT-9921
  inverterId  String
  inverter    Inverter @relation(fields: [inverterId], references: [id])
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  description String
  priority    String   @default("HIGH") // ROUTINE, HIGH, EMERGENCY
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}
